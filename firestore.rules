rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 & Phase 4.1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'kiwcukurukuk363@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'roleTitle', 'onboardingCompleted', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'roleTitle', 'onboardingCompleted', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 120 &&
        data.onboardingCompleted is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: WorkspaceSnapshot (/workspaces/{workspaceId})
    function isValidWorkspace(data) {
      return data.keys().hasAll(['ownerId', 'name', 'description', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'name', 'description', 'visibility', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() >= 0 && data.description.size() <= 1000 &&
        data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['private', 'public', 'shared'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: WorldEntity (/worlds/{worldId})
    function isValidWorld(data) {
      return data.keys().hasAll(['ownerId', 'workspaceId', 'name', 'universe', 'genre', 'synopsis', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'workspaceId', 'name', 'universe', 'genre', 'synopsis', 'visibility', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.workspaceId is string && data.workspaceId.size() >= 1 && data.workspaceId.size() <= 128 && data.workspaceId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.universe is string && data.universe.size() >= 1 && data.universe.size() <= 120 &&
        data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 120 &&
        data.synopsis is string && data.synopsis.size() >= 0 && data.synopsis.size() <= 2000 &&
        data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['private', 'public', 'password'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: ArticleEntity (/articles/{articleId})
    function isValidArticle(data) {
      return data.keys().hasAll(['ownerId', 'worldId', 'title', 'templateType', 'category', 'summary', 'content', 'status', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'worldId', 'title', 'templateType', 'category', 'summary', 'content', 'status', 'visibility', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.worldId is string && data.worldId.size() >= 1 && data.worldId.size() <= 128 && data.worldId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.templateType is string && data.templateType.size() >= 1 && data.templateType.size() <= 64 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 64 &&
        data.summary is string && data.summary.size() >= 0 && data.summary.size() <= 1000 &&
        data.content is string && data.content.size() >= 0 && data.content.size() <= 100000 &&
        data.status is string && data.status.size() <= 20 && data.status in ['draft', 'published', 'archived'] &&
        data.visibility is string && data.visibility.size() <= 20 && data.visibility in ['public', 'private', 'secret'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: CloudAccountVault (/cloud_accounts/{accountId})
    function isValidCloudAccount(data) {
      return data.keys().hasAll(['accountId', 'passwordToken', 'displayName', 'chunkCount', 'payloadChunk0', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['accountId', 'passwordToken', 'displayName', 'chunkCount', 'payloadChunk0', 'createdAt', 'updatedAt']) &&
        data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128 && data.accountId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.passwordToken is string && data.passwordToken.size() >= 8 && data.passwordToken.size() <= 128 && data.passwordToken.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 25 &&
        data.payloadChunk0 is string && data.payloadChunk0.size() >= 2 && data.payloadChunk0.size() <= 800000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: CloudBackupChunk (/cloud_backups/{chunkId})
    function isValidCloudBackupChunk(data) {
      return data.keys().hasAll(['accountId', 'passwordToken', 'chunkIndex', 'payloadChunk', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['accountId', 'passwordToken', 'chunkIndex', 'payloadChunk', 'createdAt', 'updatedAt']) &&
        data.accountId is string && data.accountId.size() >= 1 && data.accountId.size() <= 128 && data.accountId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.passwordToken is string && data.passwordToken.size() >= 8 && data.passwordToken.size() <= 128 && data.passwordToken.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.chunkIndex is int && data.chunkIndex >= 1 && data.chunkIndex <= 25 &&
        data.payloadChunk is string && data.payloadChunk.size() >= 0 && data.payloadChunk.size() <= 800000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Admins collection (read-only for self/admin, no client writes)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roleTitle', 'onboardingCompleted', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // Collection 2: /workspaces/{workspaceId}
    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && (
        existing().visibility == 'public' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );
      allow list: if existing().visibility == 'public' || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'visibility', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 3: /worlds/{worldId}
    match /worlds/{worldId} {
      allow get: if isValidId(worldId) && (
        existing().visibility == 'public' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );
      allow list: if existing().visibility == 'public' || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(worldId) &&
        isValidWorld(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(incoming().workspaceId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(worldId) &&
        isValidWorld(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/workspaces/$(existing().workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(existing().workspaceId)).data.ownerId == request.auth.uid && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'universe', 'genre', 'synopsis', 'visibility', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(worldId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 4: /articles/{articleId}
    match /articles/{articleId} {
      allow get: if isValidId(articleId) && (
        (existing().visibility == 'public' && existing().status == 'published') ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );
      allow list: if (existing().visibility == 'public' && existing().status == 'published') ||
        (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(articleId) &&
        isValidArticle(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/worlds/$(incoming().worldId)) &&
        get(/databases/$(database)/documents/worlds/$(incoming().worldId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(articleId) &&
        isValidArticle(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().worldId == existing().worldId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/worlds/$(existing().worldId)) &&
        get(/databases/$(database)/documents/worlds/$(existing().worldId)).data.ownerId == request.auth.uid && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'templateType', 'category', 'summary', 'content', 'status', 'visibility', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(articleId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 5: /cloud_accounts/{accountId}
    match /cloud_accounts/{accountId} {
      allow get: if isValidId(accountId);
      allow list: if false;
      allow create: if isValidId(accountId) &&
        isValidCloudAccount(incoming()) &&
        incoming().accountId == accountId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(accountId) &&
        isValidCloudAccount(incoming()) &&
        incoming().accountId == existing().accountId &&
        incoming().passwordToken == existing().passwordToken &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'chunkCount', 'payloadChunk0', 'updatedAt']);
      allow delete: if false;
    }

    // Collection 6: /cloud_backups/{chunkId}
    match /cloud_backups/{chunkId} {
      allow get: if isValidId(chunkId);
      allow list: if false;
      allow create: if isValidId(chunkId) &&
        isValidCloudBackupChunk(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/cloud_accounts/$(incoming().accountId)) &&
        get(/databases/$(database)/documents/cloud_accounts/$(incoming().accountId)).data.passwordToken == incoming().passwordToken;
      allow update: if isValidId(chunkId) &&
        isValidCloudBackupChunk(incoming()) &&
        incoming().accountId == existing().accountId &&
        incoming().passwordToken == existing().passwordToken &&
        incoming().chunkIndex == existing().chunkIndex &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/cloud_accounts/$(existing().accountId)) &&
        get(/databases/$(database)/documents/cloud_accounts/$(existing().accountId)).data.passwordToken == incoming().passwordToken &&
        incoming().diff(existing()).affectedKeys().hasOnly(['payloadChunk', 'updatedAt']);
      allow delete: if false;
    }
  }
}
